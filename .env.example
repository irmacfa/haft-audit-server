# الگو است؛ مقداردهی این فایل هیچ اثری ندارد. یک کپی به نام .env بسازید و رمز را آنجا بگذارید.
# SMTP Auth با صندوق اشتراکی OshanakSUP؛ در صورت ناموفق بودن میشود حساب دامین با Send As امتحان کرد
EMAIL_USER=OshanakSUP@oshanak.com
EMAIL_PASS=your_mailbox_password
# فرستنده گزارش نهایی: گروه OshanakSUP؛ حساب EMAIL_USER باید Send As روی آن داشته باشد
AUDIT_MAIL_FROM=OshanakSUP@oshanak.com
AUDIT_MAIL_FROM_LABEL=OshanakSUP
# SMTP_HOST را با «npm run test:smtp-hosts» مشخص کنید؛ گزینهها:
# email.gbgnetwork.net | mail.gbgnetwork.net | email.oshanak.com | mail.oshanak.com
SMTP_HOST=email.gbgnetwork.net
SMTP_PORT=587
SMTP_SECURE=false
# گواهی SMTP داخلی معتبر نیست؛ false یعنی ارتباط رمزشده ولی بدون تأیید گواهی
SMTP_TLS_REJECT_UNAUTHORIZED=false
# گیرنده پیشفرض اسکریپت تست SMTP (اختیاری)
SMTP_TEST_TO=
# گیرنده نهایی فقط گروه ITSUP است؛ AUDIT_NOTIFY_TO در حال حاضر استفاده نمیشود
AUDIT_NOTIFY_TO=
# گروه ایمیلی که همیشه گزارش نهایی را دریافت میکند
AUDIT_GROUP_MAIL=Oshanak-ITSUP@gbgnetwork.net
AUDIT_GROUP_LABEL=Oshanak-ITSUP
PORT=2030
ADMIN_PORT=2031

# نوتیفیکیشن تلگرام (اختیاری)
# توکن ربات را از @BotFather بگیرید و چت آیدی را از @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# حالت احراز هویت:
# ldap (پیشفرض): تمام ورودها از اکتیو دایرکتوری (شامل 관리پنل)
# hybrid: فقط حساب مدیر بهعنوان fallback محلی بماند | local: فقط برای ماشین آفلاین
AUTH_MODE=ldap
# متغیرهای زیر فقط در حالت hybrid/local استفاده میشوند و در ldap نادیده گرفته میشوند
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=change-this-password
# LOCAL_USERS_PATH=db/local_users.json

# تنظیمات اکتیو دایرکتوری (در حالت پیشفرض ldap استفاده میشود)
LDAP_URL=ldaps://DC2.gbgnetwork.net:636
LDAP_DOMAIN=gbgnetwork.net
LDAP_BASE_DN=DC=gbgnetwork,DC=net
LDAP_NETBIOS=GBGNETWORK
LDAP_UPN_SUFFIXES=gbgnetwork.net,oshanak.com
LDAP_ALLOWED_GROUP=Oshanak-ITSUP
# حساب دامین با این نام دسترسی مدیریت دارد؛ در حالت hybrid/local پرچم admin کاربر محلی هم ملاک است
ADMIN_USERNAME=aghanbari
# گواهی DC2 از ۲۰۲۲ منقضی است؛ تا تمدید گواهی false بماند (اتصال Still رمزشده است)
# پس از تمدید گواهی دامین، حتماً دوباره true کنید
LDAP_TLS_REJECT_UNAUTHORIZED=false

# حتماً این دو مقدار را با رشته تصادفی جایگزین کنید
SESSION_SECRET=replace-with-random-hex
INTERNAL_TOKEN=replace-with-random-hex
SESSION_TTL_HOURS=8
COOKIE_NAME=haft_session
COOKIE_SECURE=false
