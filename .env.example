EMAIL_USER=audit-system@haftstores.ir
EMAIL_PASS=your_email_app_password
# SMTP (پیشفرضها همان مقادیر زیراند؛ فقط در صورت نیاز تغییر دهید)
SMTP_HOST=mail.haftstores.ir
SMTP_PORT=587
SMTP_SECURE=false
# گیرنده پیشفرض اسکریپت تست SMTP (اختیاری)
SMTP_TEST_TO=
# گیرندگان اضافی گزارش نهایی انبارگردانی؛ چند آدرس با کاما/سمی‌کالن. خالی = اول ایمیل گروه AD، بعد ایمیل اعضای گروه.
AUDIT_NOTIFY_TO=
# گروه ایمیلی که همیشه گزارش نهایی را دریافت میکند (علاوه بر گیرندگان بالا)
AUDIT_GROUP_MAIL=Oshanak-ITSUP@gbgnetwork.net
AUDIT_GROUP_LABEL=Oshanak-ITSUP
PORT=2030
ADMIN_PORT=2031

# نوتیفیکیشن تلگرام (اختیاری)
# توکن ربات را از @BotFather بگیرید و چت آیدی را از @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# حالت احراز هویت:
# hybrid (پیشفرض): مدیر محلی، سایر کاربران از اکتیو دایرکتوری
# local: همه کاربران محلی (ماشین کاملاً آفلاین) | ldap: همه از دامین
AUTH_MODE=hybrid
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=change-this-password
# LOCAL_USERS_PATH=db/local_users.json

# تنظیمات اکتیو دایرکتوری (در حالت hybrid و ldap استفاده میشود)
LDAP_URL=ldaps://DC2.gbgnetwork.net:636
LDAP_DOMAIN=gbgnetwork.net
LDAP_BASE_DN=DC=gbgnetwork,DC=net
LDAP_NETBIOS=GBGNETWORK
LDAP_UPN_SUFFIXES=gbgnetwork.net,oshanak.com
LDAP_ALLOWED_GROUP=Oshanak-ITSUP
# در حالت ldap/hybrid مدیر دامین با این نام هم دسترسی مدیریت دارد؛ در حالت hybrid/local پرچم admin کاربر محلی هم ملاک است
ADMIN_USERNAME=aghanbari
# در صورتی که گواهی LDAPS معتبر است true بگذارید
LDAP_TLS_REJECT_UNAUTHORIZED=true

# حتماً این دو مقدار را با رشته تصادفی جایگزین کنید
SESSION_SECRET=replace-with-random-hex
INTERNAL_TOKEN=replace-with-random-hex
SESSION_TTL_HOURS=8
COOKIE_NAME=haft_session
COOKIE_SECURE=false
